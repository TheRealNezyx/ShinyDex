<?xml version="1.0" encoding="utf-8"?>
<!-- Security control: the hunt database is never exported to cloud/device-transfer backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
