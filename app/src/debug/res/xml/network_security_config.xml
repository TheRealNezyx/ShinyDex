<?xml version="1.0" encoding="utf-8"?>
<!--
  SOLO VERSIONES DE PRUEBA. Este archivo reemplaza a src/main/res/xml/network_security_config.xml.

  Durante el desarrollo el servidor de Face-off corre en una computadora de la red local y
  habla HTTP sin cifrar. La versión final no incluye este archivo, así que mantiene la
  política de solo HTTPS y necesita un servidor con TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
